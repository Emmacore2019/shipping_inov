        <record id="mail_act_rh_shipping_0" model="mail.activity.type">
            <field name="name">1-ACCEPTATION DE LA NOMINATION DU CLIENT POUR L’ARRAISONNEMENT DE SON NAVIRE</field>
            <field name="icon">fa-ship</field>
            <field name="stages">ship</field>
            <field name="res_model">folder.transit</field>
        </record>
        <record id="mail_act_rh_shipping_1" model="mail.activity.type">
