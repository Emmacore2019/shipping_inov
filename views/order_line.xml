<odoo>
    <data>
        <record id="view_order_form_inherit_euro" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.euro</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="after">
                    <field name="price_usd_subtotal" string="Euro" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
