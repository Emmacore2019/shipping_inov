<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

      <menuitem name="Shipping" id="menu_shipping_root_id" web_icon="inov_shipping,static/description/icon.png"
            sequence="60"/>
    <menuitem name="Tableau de bord" id="menu_dashboard_shipping_id" parent="menu_shipping_root_id" sequence="1" />
     <menuitem name="Dossiers" id="menu_folder_shipping_id" parent="menu_shipping_root_id" sequence="2" />
     <menuitem name="Donnee de Base" id="menu_folder_base_id" parent="menu_shipping_root_id" sequence="3" />
     <menuitem name="Facturation et Reglement" id="menu_folder_accounting_id" parent="menu_shipping_root_id" sequence="4"/>
      <menuitem name="Article" id="menu_folder_product_id" parent="menu_folder_base_id" sequence="1" action="stock.product_template_action_product"/>
     <menuitem name="Rapports" id="menu_report_id" parent="menu_shipping_root_id" sequence="5" groups="inov_transit.group_shipping_manager"/>
    <menuitem name="Configuration" id="menu_shipping_configuration_id" parent="menu_shipping_root_id" sequence="6" />


    <record id="action_task_checklist_shipping" model="ir.actions.act_window">
    <field name="name">Analyse des tâches</field>
    <field name="res_model">task.checklist</field>
    <field name="view_mode">graph,pivot</field>
     <field name="search_view_id" ref="inov_transit.view_task_checklist_analysis_search"/>
     <field name="context">{
        'search_default_current_year':1,
        }</field>
    <field name="domain">[('state', '=', 'ship')]</field>
</record>

<menuitem id="menu_task_checklist_shipping" name="Analyse des tâches" parent="inov_shipping.menu_report_id" action="action_task_checklist_shipping"/>
    </data>
